# Local development: copy to backend/.env
# Without BOT_TOKEN and with DEV_AUTH=1 the app opens in a regular browser (user ?dev=<id>)
DEV_AUTH=1
AUTO_CREATE_SCHEMA=1
DATABASE_URL=sqlite+aiosqlite:///./data/dev.db

# Test bot (NOT the production token!). polling locally, webhook on Railway
BOT_TOKEN=
BOT_MODE=off
WEBAPP_URL=
WEBHOOK_SECRET=
ADMIN_IDS=

# Match analysis (OpenDota): free in beta; otherwise N per week + a Stars subscription
ANALYSIS_BETA_FREE=1
ANALYSIS_PRICE_STARS=200
ANALYSIS_FREE_PER_WEEK=1

# Video contest: YouTube Data API v3 key for view counts (without it an admin enters views)
YOUTUBE_API_KEY=

# OpenDota key (opendota.com -> API Key): no daily limit, faster draft and analysis loading
OPENDOTA_API_KEY=
